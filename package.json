{
  "name": "sloth-watch",
  "version": "0.1.0",
  "private": true,
  "description": "An overnight agent that reads the news about the tools a small business runs on, and wakes the owner only when one needs action.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "server": "temporal server start-dev --db-filename sloth.db",
    "worker": "node src/worker.js",
    "start": "node src/start.js",
    "test": "node --test --test-concurrency=1 test/lib.test.js && node --test --test-concurrency=1 test/workflow.test.js"
  },
  "dependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0"
  },
  "devDependencies": {
    "@temporalio/testing": "1.24.0"
  }
}
